FROM tpoechtrager/osxcross:latest AS builder

# The image has osxcross installed in /osxcross.
ENV PATH=/osxcross/target/bin:${PATH}
ENV MACOSX_DEPLOYMENT_TARGET=11.0

WORKDIR /app
COPY . /app

# Build for x86_64
RUN mkdir -p build-x86_64 && cd build-x86_64 && \
    cmake .. \
    -DCMAKE_BUILD_TYPE=Release \
    -DCMAKE_TOOLCHAIN_FILE=/osxcross/target/share/osxcross/cmake/osxcross.cmake \
    -DCMAKE_OSX_ARCHITECTURES=x86_64 \
    -DCMAKE_OSX_DEPLOYMENT_TARGET=${MACOSX_DEPLOYMENT_TARGET} && \
    make -j$(nproc)

# Build for arm64
RUN mkdir -p build-arm64 && cd build-arm64 && \
    cmake .. \
    -DCMAKE_BUILD_TYPE=Release \
    -DCMAKE_TOOLCHAIN_FILE=/osxcross/target/share/osxcross/cmake/osxcross.cmake \
    -DCMAKE_OSX_ARCHITECTURES=arm64 \
    -DCMAKE_OSX_DEPLOYMENT_TARGET=${MACOSX_DEPLOYMENT_TARGET} && \
    make -j$(nproc)

# Create universal binary and app bundle
RUN mkdir -p 3dco.app/Contents/MacOS && \
    /osxcross/target/bin/lipo -create build-x86_64/3dco build-arm64/3dco -output 3dco.app/Contents/MacOS/3dco && \
    chmod +x 3dco.app/Contents/MacOS/3dco && \
    echo '<?xml version="1.0" encoding="UTF-8"?>\n\
    <!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">\n\
    <plist version="1.0">\n\
    <dict>\n\
    <key>CFBundleExecutable</key>\n\
    <string>3dco</string>\n\
    <key>CFBundleIdentifier</key>\n\
    <string>com.yourcompany.3dco</string>\n\
    <key>CFBundleName</key>\n\
    <string>3D Controller Overlay</string>\n\
    <key>CFBundlePackageType</key>\n\
    <string>APPL</string>\n\
    <key>CFBundleShortVersionString</key>\n\
    <string>1.0</string>\n\
    <key>LSMinimumSystemVersion</key>\n\
    <string>11.0</string>\n\
    </dict>\n\
    </plist>' > 3dco.app/Contents/Info.plist

CMD cp -r /app/3dco.app /dist/macos/