FROM dockcross/windows-static-x64:latest

RUN apt-get update && apt-get install -y --no-install-recommends \
    git \
    wget \
    ca-certificates \
    && apt-get clean

# ---------- Build Assimp from source with -Werror disabled ----------
WORKDIR /tmp
RUN wget -q https://github.com/assimp/assimp/archive/refs/tags/v5.4.3.tar.gz && \
    tar xzf v5.4.3.tar.gz && \
    cd assimp-5.4.3 && \
    # Patch: remove all -Werror flags from CMakeLists.txt
    sed -i 's/ -Werror//g' CMakeLists.txt && \
    sed -i 's/ -Wno-error//g' CMakeLists.txt && \
    mkdir build && cd build && \
    cmake .. \
    -DCMAKE_INSTALL_PREFIX=$CROSS_ROOT/$MXE_TARGET \
    -DBUILD_SHARED_LIBS=OFF \
    -DASSIMP_BUILD_TESTS=OFF \
    -DASSIMP_BUILD_SAMPLES=OFF \
    -DASSIMP_BUILD_ASSIMP_TOOLS=OFF \
    -DASSIMP_BUILD_BLENDER_IMPORTER=OFF && \
    make -j$(nproc) && \
    make install && \
    cd ../.. && rm -rf assimp-5.4.3*

# Verify
RUN ls -l $CROSS_ROOT/$MXE_TARGET/include/assimp/scene.h && \
    ls -l $CROSS_ROOT/$MXE_TARGET/lib/libassimp.a

WORKDIR /app
COPY . /app

# Build: CMake will fetch SDL2, GLFW, fmt, spdlog, nlohmann_json from source.
# Assimp is already in the sysroot.
RUN mkdir build && cd build && \
    cmake .. \
    -DCMAKE_BUILD_TYPE=Release \
    -DCMAKE_CXX_FLAGS="-static-libgcc -static-libstdc++" \
    -DBUILD_STATIC=ON && \
    make -j$(nproc)

CMD mkdir -p /dist/windows && \
    cp /app/build/3dco+.exe /dist/windows/ && \
    cp -r /app/assets/models /dist/windows/