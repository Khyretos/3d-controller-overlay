# syntax=docker/dockerfile:1

ARG OSXCROSS_VERSION=26.1-r0

# ============================================================
# OSXCross image
# ============================================================

FROM crazymax/osxcross:${OSXCROSS_VERSION}-ubuntu AS osxcross


# ============================================================
# Linux build environment
# ============================================================

FROM ubuntu:24.04

ENV DEBIAN_FRONTEND=noninteractive

RUN apt-get update && \
    apt-get install -y --no-install-recommends \
    build-essential \
    clang-20 \
    clang++-20 \
    cmake \
    ninja-build \
    pkg-config \
    git \
    curl \
    ca-certificates \
    unzip \
    zip \
    file \
    xz-utils \
    && \
    ln -sf /usr/bin/clang-20 /usr/bin/clang \
    && \
    ln -sf /usr/bin/clang++-20 /usr/bin/clang++ \
    && \
    rm -rf /var/lib/apt/lists/*


# ============================================================
# OSXCross
# ============================================================

COPY --from=osxcross /osxcross /osxcross

RUN ln -sf \
    /osxcross/bin/arm64-apple-darwin25.1-install_name_tool \
    /usr/local/bin/install_name_tool \
    && ln -sf \
    /osxcross/bin/arm64-apple-darwin25.1-otool \
    /usr/local/bin/otool

ENV PATH="/osxcross/bin:${PATH}"
ENV LD_LIBRARY_PATH="/osxcross/lib"
ENV MACOSX_DEPLOYMENT_TARGET=11.0


# ============================================================
# Architecture supplied by build script
# ============================================================

ARG ARCH

RUN test -n "${ARCH}"


# ============================================================
# Build script
# ============================================================

RUN cat > /usr/local/bin/build-deps.sh <<'SCRIPT'
#!/usr/bin/env bash

set -euo pipefail

ARCH="${ARCH:?ARCH is required}"

case "${ARCH}" in
    x86_64)
        CC="o64-clang"
        CXX="o64-clang++"
        TARGET="x86_64-apple-darwin25.1"
        ;;
    arm64)
        CC="oa64-clang"
        CXX="oa64-clang++"
        TARGET="arm64-apple-darwin25.1"
        ;;
    *)
        echo "ERROR: Unsupported architecture: ${ARCH}"
        exit 1
        ;;
esac

PREFIX="/out"
WORK="/tmp/deps-${ARCH}"

rm -rf "${PREFIX}" "${WORK}"

mkdir -p \
    "${PREFIX}" \
    "${WORK}"

export CC
export CXX

export AR="/osxcross/bin/${TARGET}-ar"
export RANLIB="/osxcross/bin/${TARGET}-ranlib"
export NM="/osxcross/bin/${TARGET}-nm"
export STRIP="/osxcross/bin/${TARGET}-strip"

export PKG_CONFIG_PATH="${PREFIX}/lib/pkgconfig:${PREFIX}/share/pkgconfig"
export PKG_CONFIG_LIBDIR="${PREFIX}/lib/pkgconfig:${PREFIX}/share/pkgconfig"

echo
echo "============================================================"
echo "Building macOS dependencies"
echo "Architecture: ${ARCH}"
echo "CC:           ${CC}"
echo "CXX:          ${CXX}"
echo "AR:           ${AR}"
echo "RANLIB:       ${RANLIB}"
echo "Prefix:       ${PREFIX}"
echo "============================================================"
echo


# ============================================================
# Common CMake options
# ============================================================

COMMON_CMAKE=(
    -G Ninja
    -DCMAKE_BUILD_TYPE=Release
    -DCMAKE_SYSTEM_NAME=Darwin
    -DCMAKE_SYSTEM_PROCESSOR="${ARCH}"
    -DCMAKE_OSX_ARCHITECTURES="${ARCH}"
    -DCMAKE_OSX_DEPLOYMENT_TARGET="${MACOSX_DEPLOYMENT_TARGET}"
    -DCMAKE_C_COMPILER="${CC}"
    -DCMAKE_CXX_COMPILER="${CXX}"
    -DCMAKE_AR="${AR}"
    -DCMAKE_RANLIB="${RANLIB}"
    -DCMAKE_INSTALL_PREFIX="${PREFIX}"
    -DCMAKE_PREFIX_PATH="${PREFIX}"
    -DBUILD_SHARED_LIBS=OFF
)


# ============================================================
# Helper functions
# ============================================================

download()
{
    local url="$1"
    local output="$2"

    echo "Downloading:"
    echo "  ${url}"

    curl \
        --fail \
        --location \
        --retry 3 \
        "${url}" \
        -o "${output}"
}


extract_tar()
{
    local archive="$1"
    local destination="$2"

    rm -rf "${destination}"

    mkdir -p "${destination}"

    tar \
        -xzf "${archive}" \
        -C "${destination}" \
        --strip-components=1
}


refresh_archives()
{
    if [[ -d "${PREFIX}/lib" ]]; then
        while IFS= read -r -d '' archive; do
            echo "Indexing ${archive}"
            "${RANLIB}" "${archive}"
        done < <(
            find "${PREFIX}/lib" \
                -type f \
                -name '*.a' \
                -print0
        )
    fi
}


# ============================================================
# zlib
# ============================================================

echo
echo "------------------------------------------------------------"
echo "Building zlib"
echo "------------------------------------------------------------"

ZLIB_VERSION="1.3.1"

download \
    "https://github.com/madler/zlib/releases/download/v${ZLIB_VERSION}/zlib-${ZLIB_VERSION}.tar.gz" \
    "${WORK}/zlib.tar.gz"

extract_tar \
    "${WORK}/zlib.tar.gz" \
    "${WORK}/zlib"

cmake \
    -S "${WORK}/zlib" \
    -B "${WORK}/zlib/build" \
    "${COMMON_CMAKE[@]}" \
    -DZLIB_BUILD_TESTING=OFF

cmake \
    --build "${WORK}/zlib/build" \
    --parallel

cmake \
    --install "${WORK}/zlib/build"

refresh_archives


# ============================================================
# GLFW
# ============================================================

echo
echo "------------------------------------------------------------"
echo "Building GLFW"
echo "------------------------------------------------------------"

GLFW_VERSION="3.3.9"

download \
    "https://github.com/glfw/glfw/archive/refs/tags/${GLFW_VERSION}.zip" \
    "${WORK}/glfw.zip"

rm -rf "${WORK}/glfw" "${WORK}/glfw-src"

mkdir -p "${WORK}/glfw-src"

unzip \
    -q \
    "${WORK}/glfw.zip" \
    -d "${WORK}/glfw-src"

mv \
    "${WORK}/glfw-src/glfw-${GLFW_VERSION}" \
    "${WORK}/glfw"

cmake \
    -S "${WORK}/glfw" \
    -B "${WORK}/glfw/build" \
    "${COMMON_CMAKE[@]}" \
    -DGLFW_BUILD_DOCS=OFF \
    -DGLFW_BUILD_TESTS=OFF \
    -DGLFW_BUILD_EXAMPLES=OFF

cmake \
    --build "${WORK}/glfw/build" \
    --parallel

cmake \
    --install "${WORK}/glfw/build"

refresh_archives

# ============================================================
# SDL2
# ============================================================

echo
echo "------------------------------------------------------------"
echo "Building SDL2"
echo "------------------------------------------------------------"

SDL2_VERSION="2.30.1"

download \
    "https://github.com/libsdl-org/SDL/releases/download/release-${SDL2_VERSION}/SDL2-${SDL2_VERSION}.tar.gz" \
    "${WORK}/sdl2.tar.gz"

extract_tar \
    "${WORK}/sdl2.tar.gz" \
    "${WORK}/sdl2"

cmake \
    -S "${WORK}/sdl2" \
    -B "${WORK}/sdl2/build" \
    "${COMMON_CMAKE[@]}" \
    -DSDL_TESTS=OFF \
    -DSDL_GAMECONTROLLER=OFF \
    -DSDL_HAPTIC=OFF

cmake \
    --build "${WORK}/sdl2/build" \
    --parallel

cmake \
    --install "${WORK}/sdl2/build"

refresh_archives


# ============================================================
# fmt
# ============================================================

echo
echo "------------------------------------------------------------"
echo "Building fmt"
echo "------------------------------------------------------------"

FMT_VERSION="10.2.1"

download \
    "https://github.com/fmtlib/fmt/archive/refs/tags/${FMT_VERSION}.tar.gz" \
    "${WORK}/fmt.tar.gz"

extract_tar \
    "${WORK}/fmt.tar.gz" \
    "${WORK}/fmt"

cmake \
    -S "${WORK}/fmt" \
    -B "${WORK}/fmt/build" \
    "${COMMON_CMAKE[@]}" \
    -DFMT_TEST=OFF \
    -DFMT_DOC=OFF \
    -DFMT_INSTALL=ON

cmake \
    --build "${WORK}/fmt/build" \
    --parallel

cmake \
    --install "${WORK}/fmt/build"

refresh_archives


# ============================================================
# spdlog
# ============================================================

echo
echo "------------------------------------------------------------"
echo "Building spdlog"
echo "------------------------------------------------------------"

SPDLOG_VERSION="1.14.1"

download \
    "https://github.com/gabime/spdlog/archive/refs/tags/v${SPDLOG_VERSION}.tar.gz" \
    "${WORK}/spdlog.tar.gz"

extract_tar \
    "${WORK}/spdlog.tar.gz" \
    "${WORK}/spdlog"

cmake \
    -S "${WORK}/spdlog" \
    -B "${WORK}/spdlog/build" \
    "${COMMON_CMAKE[@]}" \
    -DSPDLOG_FMT_EXTERNAL=ON \
    -DSPDLOG_BUILD_EXAMPLE=OFF \
    -DSPDLOG_BUILD_TESTS=OFF \
    -DSPDLOG_BUILD_BENCH=OFF \
    -Dfmt_DIR="${PREFIX}/lib/cmake/fmt"

cmake \
    --build "${WORK}/spdlog/build" \
    --parallel

cmake \
    --install "${WORK}/spdlog/build"

refresh_archives


# ============================================================
# nlohmann/json
# ============================================================

echo
echo "------------------------------------------------------------"
echo "Installing nlohmann/json"
echo "------------------------------------------------------------"

JSON_VERSION="3.11.3"

mkdir -p \
    "${PREFIX}/include/nlohmann" \
    "${PREFIX}/lib/pkgconfig"

download \
    "https://github.com/nlohmann/json/releases/download/v${JSON_VERSION}/json.hpp" \
    "${PREFIX}/include/nlohmann/json.hpp"

cat > "${PREFIX}/lib/pkgconfig/nlohmann_json.pc" <<PC
prefix=${PREFIX}
includedir=\${prefix}/include

Name: nlohmann_json
Description: JSON for Modern C++
Version: ${JSON_VERSION}
Cflags: -I\${includedir}
PC


# ============================================================
# Assimp
# ============================================================

echo
echo "------------------------------------------------------------"
echo "Building Assimp"
echo "------------------------------------------------------------"

ASSIMP_VERSION="5.4.3"

download \
    "https://github.com/assimp/assimp/archive/refs/tags/v${ASSIMP_VERSION}.tar.gz" \
    "${WORK}/assimp.tar.gz"

extract_tar \
    "${WORK}/assimp.tar.gz" \
    "${WORK}/assimp"

cmake \
    -S "${WORK}/assimp" \
    -B "${WORK}/assimp/build" \
    "${COMMON_CMAKE[@]}" \
    -DASSIMP_BUILD_TESTS=OFF \
    -DASSIMP_BUILD_SAMPLES=OFF \
    -DASSIMP_BUILD_ASSIMP_TOOLS=OFF \
    -DASSIMP_WARNINGS_AS_ERRORS=OFF \
    -DASSIMP_BUILD_ZLIB=OFF \
    -DZLIB_ROOT="${PREFIX}" \
    -DZLIB_LIBRARY="${PREFIX}/lib/libz.a" \
    -DZLIB_INCLUDE_DIR="${PREFIX}/include"

cmake \
    --build "${WORK}/assimp/build" \
    --parallel

cmake \
    --install "${WORK}/assimp/build"

refresh_archives


# ============================================================
# Validate output
# ============================================================

echo
echo "============================================================"
echo "Validating ${ARCH} dependencies"
echo "============================================================"

required_files=(
    "${PREFIX}/include/GLFW/glfw3.h"
    "${PREFIX}/include/SDL2/SDL.h"
    "${PREFIX}/include/nlohmann/json.hpp"
    "${PREFIX}/lib/libglfw3.a"
    "${PREFIX}/lib/libSDL2.a"
    "${PREFIX}/lib/libfmt.a"
    "${PREFIX}/lib/libspdlog.a"
    "${PREFIX}/lib/libassimp.a"
    "${PREFIX}/lib/libz.a"
    "${PREFIX}/lib/pkgconfig/glfw3.pc"
    "${PREFIX}/lib/pkgconfig/sdl2.pc"
    "${PREFIX}/lib/pkgconfig/nlohmann_json.pc"
)

for file in "${required_files[@]}"; do
    if [[ ! -e "${file}" ]]; then
        echo
        echo "ERROR: Missing required file:"
        echo "  ${file}"
        exit 1
    fi
done

echo
echo "All required ${ARCH} dependency files exist."

echo
echo "Dependency tree:"
find "${PREFIX}" -maxdepth 3 -type f | sort

echo
echo "============================================================"
echo "${ARCH} dependency build complete"
echo "============================================================"
SCRIPT

RUN chmod +x /usr/local/bin/build-deps.sh

RUN /usr/local/bin/build-deps.sh